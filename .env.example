# ---- Database (required) ----
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon:   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- YouTube upload OAuth (needed for auto-publish) ----
# console.cloud.google.com -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Token encryption at rest (any long random string) ----
# generate:  openssl rand -hex 32
CREDENTIAL_ENC_KEY=

# ---- Optional: force a public origin for OAuth redirect ----
# PUBLIC_ORIGIN=https://your-app.vercel.app
